generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid(7)) @db.Uuid
  username     String   @unique
  email        String   @unique
  passwordHash String
  // School / college, asked at registration (decision.md D-076). Null for accounts that predate it.
  institution     String?
  emailVerifiedAt DateTime?
  // Glicko-2 rating state (see decision.md D-010)
  rating       Float    @default(1500)
  ratingDev    Float    @default(350)
  volatility   Float    @default(0.06)
  // ratingDev is exact as of this instant; idle inflation since then is applied lazily (decision.md D-047)
  rdUpdatedAt  DateTime @default(now())
  ratedGames   Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  refreshTokens RefreshToken[]
  submissions   Submission[]
  matches       MatchPlayer[]
  seenProblems  SeenProblem[]
  projectRuns   ProjectRun[]
  // Public profile (decision.md D-071)
  bio             String?
  // { github?, linkedin?, x?, website? }: https URLs, validated on write
  links           Json?
  // Set when an avatar is uploaded; doubles as the cache-buster in its URL
  avatarUpdatedAt DateTime?
  avatar          Avatar?
  ratingHistory RatingHistory[]

  @@index([ratedGames, rating])
}

model RefreshToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // SHA-256 of the opaque token; the raw token only ever lives in the httpOnly cookie
  tokenHash String    @unique
  // All tokens produced by rotating one login share a family; reuse of a revoked token kills the family
  familyId  String    @db.Uuid
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([familyId])
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum Language {
  python
  cpp
}

enum Verdict {
  ACCEPTED
  WRONG_ANSWER
  TLE
  MLE
  RUNTIME_ERROR
  COMPILE_ERROR
}

enum SubmissionKind {
  RUN // sample tests only, full I/O shown to the user
  SUBMIT // every test; hidden test I/O is never exposed
}

enum SubmissionStatus {
  QUEUED
  RUNNING
  DONE
  FAILED // judge infrastructure error, not a verdict on the code
}

model Problem {
  id            String     @id @default(uuid(7)) @db.Uuid
  slug          String     @unique
  title         String
  difficulty    Difficulty
  statement     String // markdown
  // Base limit; Python gets a multiplier (see decision.md D-026)
  timeLimitMs   Int        @default(1000)
  memoryLimitMb Int        @default(256)
  starterCode   Json // { python: string, cpp: string }
  // Topic labels for the practice list (decision.md D-064)
  tags          String[]   @default([])
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  testCases   TestCase[]
  submissions Submission[]
  matches     Match[]
  seenBy      SeenProblem[]

  @@index([difficulty])
}

model TestCase {
  id        String  @id @default(uuid(7)) @db.Uuid
  problemId String  @db.Uuid
  problem   Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  ordinal   Int
  input     String
  expected  String
  isSample  Boolean @default(false)

  @@unique([problemId, ordinal])
}

model Submission {
  id            String           @id @default(uuid(7)) @db.Uuid
  userId        String           @db.Uuid
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  problemId     String           @db.Uuid
  problem       Problem          @relation(fields: [problemId], references: [id], onDelete: Cascade)
  kind          SubmissionKind
  language      Language
  code          String
  status        SubmissionStatus @default(QUEUED)
  verdict       Verdict?
  testsPassed   Int?
  testsTotal    Int?
  maxTimeMs     Int?
  compileOutput String?
  // Per-test results; for RUN also truncated stdout/stderr (see TestResultView in @thegrave/shared)
  results       Json?
  // Set for submissions made inside a battle
  matchId       String?          @db.Uuid
  match         Match?           @relation(fields: [matchId], references: [id], onDelete: Cascade)
  createdAt     DateTime         @default(now())
  finishedAt    DateTime?

  @@index([userId, createdAt])
  @@index([problemId])
  @@index([matchId, userId])
}

enum MatchStatus {
  PENDING // created, countdown running, problem hidden
  ACTIVE
  FINISHED
  ABORTED // no result: both players gone
}

enum MatchEndReason {
  SOLVED // first full ACCEPTED
  TIMEOUT // decided on tests passed (or draw) at endsAt
  FORFEIT // a player stayed disconnected past the grace period
  ABANDONED // both players disconnected
  AGREED // both players agreed to a draw (decision.md D-068)
  RESIGNED // a player quit
}

enum MatchMode {
  DSA // one problem, stdin/stdout judge
  PROGRAMMING // a codebase to debug, graded by its hidden tests (decision.md D-067)
}

model Match {
  id         String          @id @default(uuid(7)) @db.Uuid
  mode       MatchMode       @default(DSA)
  // Exactly one of these is set, by mode
  problemId  String?         @db.Uuid
  problem    Problem?        @relation(fields: [problemId], references: [id])
  projectId  String?         @db.Uuid
  project    Project?        @relation(fields: [projectId], references: [id])
  status     MatchStatus     @default(PENDING)
  // Server-authoritative timer (decision.md D-009)
  startsAt   DateTime
  endsAt     DateTime
  finishedAt DateTime?
  // null on FINISHED means a draw
  winnerId   String?         @db.Uuid
  endReason  MatchEndReason?
  // Set in the same transaction that applies the rating change: the idempotency gate (D-048)
  ratedAt    DateTime?
  // False for private-room matches: they never touch ratings (decision.md D-065)
  rated      Boolean         @default(true)
  createdAt  DateTime        @default(now())

  players       MatchPlayer[]
  submissions   Submission[]
  projectRuns   ProjectRun[]
  ratingChanges RatingHistory[]

  @@index([status])
}

model MatchPlayer {
  matchId      String @db.Uuid
  match        Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  userId       String @db.Uuid
  user         User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Snapshot for Phase 5 (Glicko-2 update) and for display
  ratingBefore Float

  @@id([matchId, userId])
  @@index([userId])
}

/// A problem a user has seen (practice view, any submission, or a battle). Battles avoid these.
model SeenProblem {
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  problemId String   @db.Uuid
  problem   Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)
  seenAt    DateTime @default(now())

  @@id([userId, problemId])
  @@index([problemId])
}

enum GameOutcome {
  WIN
  LOSS
  DRAW
}

model RatingHistory {
  id               String      @id @default(uuid(7)) @db.Uuid
  userId           String      @db.Uuid
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  matchId          String      @db.Uuid
  match            Match       @relation(fields: [matchId], references: [id], onDelete: Cascade)
  opponentId       String      @db.Uuid
  outcome          GameOutcome
  ratingBefore     Float
  ratingAfter      Float
  delta            Float
  // RD as used for the update (already inflated for idle time) and after it
  rdBefore         Float
  rdAfter          Float
  volatilityBefore Float
  volatilityAfter  Float
  opponentRating   Float
  createdAt        DateTime    @default(now())

  // Backstop for idempotency: one rating change per player per match
  @@unique([matchId, userId])
  @@index([userId, createdAt])
}

// ---- Programming challenges: debug a small codebase (decision.md D-066) ----------------------------

enum ProjectLanguage {
  python
  node
}

model Project {
  id          String          @id @default(uuid(7)) @db.Uuid
  slug        String          @unique
  title       String
  difficulty  Difficulty
  language    ProjectLanguage
  summary     String
  statement   String // markdown
  tags        String[]        @default([])
  // Starter codebase { path: content }, sent to the player
  files       Json
  // Grading tests { path: content } under __grave__/, never sent to the client
  hiddenTests Json
  // Size of the hidden suite: a SUBMIT is solved only if this many tests passed
  hiddenTestCount Int
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  runs    ProjectRun[]
  matches Match[]
}

enum ProjectRunKind {
  COMMAND // a terminal command
  TEST // the visible tests in tests/
  SUBMIT // the hidden tests: this is what counts as solved
}

model ProjectRun {
  id         String           @id @default(uuid(7)) @db.Uuid
  userId     String           @db.Uuid
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId  String           @db.Uuid
  project    Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  // Set for SUBMITs made inside a programming battle
  matchId    String?          @db.Uuid
  match      Match?           @relation(fields: [matchId], references: [id], onDelete: Cascade)
  kind       ProjectRunKind
  command    String?
  // The player's files at the time of the run
  files      Json
  status     SubmissionStatus @default(QUEUED)
  exitCode   Int?
  output     String?
  timedOut   Boolean          @default(false)
  passed     Int?
  total      Int?
  // [{ name, status, message }] for TEST and SUBMIT
  results    Json?
  timeMs     Int?
  createdAt  DateTime         @default(now())
  finishedAt DateTime?

  @@index([userId, projectId, createdAt])
  @@index([matchId, userId])
}

// Profile pictures live apart from User so loading a user never drags the image along (decision.md D-071).
model Avatar {
  userId    String   @id @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // PNG, JPEG or WebP; content-checked by magic bytes, at most 256 KB
  data      Bytes
  mime      String
  updatedAt DateTime @updatedAt
}
