NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173
# Reverse proxies in front of the API (production behind Caddy: 1). See production.md.
# TRUST_PROXY=1

DATABASE_URL=postgresql://grave:grave@localhost:5442/thegrave?schema=public
REDIS_URL=redis://localhost:6389

# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7

# Code execution backend: "docker" (local sandboxed containers). See decision.md D-008.
EXECUTOR=docker
JUDGE_IMAGE=thegrave-judge:latest
# JUDGE_RUNTIME=runsc
JUDGE_CONCURRENCY=2
JUDGE_QUEUE_MAX=500

# Battles: countdown before the problem is revealed, reconnect grace, submit cooldown.
BATTLE_COUNTDOWN_MS=5000
BATTLE_RECONNECT_GRACE_MS=30000
BATTLE_SUBMIT_COOLDOWN_MS=5000
# BATTLE_DURATION_MS=60000   # overrides the per-difficulty duration (tests only)

# Registration codes are emailed. In development without SMTP_HOST the code is printed in the server console;
# `docker compose up -d mailpit` gives a local inbox at http://localhost:8025 (SMTP_HOST=localhost, SMTP_PORT=1025).
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM="TheGrave <no-reply@thegrave.dev>"

# AI hint coach for programming practice. Without a key it answers "not set up".
# ANTHROPIC_API_KEY=
# HINT_MODEL=claude-sonnet-5-5
