# Production settings for docker-compose.prod.yml. Copy to `.env.production`, fill in EVERY value, and never
# commit the copy (it is gitignored). See production.md.

# ---- Site ----------------------------------------------------------------------------------------------
# Your public domain, without scheme. Its DNS A/AAAA record must point at this server before the first start,
# so Caddy can get a certificate.
DOMAIN=thegrave.example
# Optional. Leave unset in production. `:80` serves plain http for a local trial.
# SITE_ADDRESS=:80

# ---- Secrets: generate each one separately -------------------------------------------------------------------
# Use hex for the two passwords (they go into URLs): openssl rand -hex 24
POSTGRES_PASSWORD=
REDIS_PASSWORD=
# Two DIFFERENT secrets: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# ---- Email (registration codes). The server refuses to start without these. ----------------------------------------
SMTP_HOST=in-v3.mailjet.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Must be a sender (ideally on your own domain, with SPF/DKIM set up) verified at your mail provider.
MAIL_FROM="TheGrave <no-reply@thegrave.example>"

# ---- AI hint coach (optional) -------------------------------------------------------------------------------------
# Without a key the coach answers "not set up". Never put the key in the repo.
ANTHROPIC_API_KEY=
HINT_MODEL=claude-sonnet-5-5
# Or use DeepSeek instead (only when ANTHROPIC_API_KEY is empty): https://platform.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
# Or Groq: https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Which one answers when several keys are set: anthropic | deepseek | groq (default: first key set, in that order)
HINT_PROVIDER=

# ---- Judge capacity (optional) --------------------------------------------------------------------------------------
JUDGE_CONCURRENCY=2
WORKSPACE_CONCURRENCY=2
# Max characters of the player's code sent per hint (default 122880). Groq's free tier needs about 9000.
HINT_WORKSPACE_CAP=122880
